# ==============================================================================
# Google Cloud & ADK Agent Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your settings:
#   cp .env.example .env
# ==============================================================================

# --- Google Cloud Project Configuration ---
# Your Google Cloud Project ID (e.g. my-agent-project)
GOOGLE_CLOUD_PROJECT=your-project-id

# Your Google Cloud Project Number (e.g. 123456789012)
PROJECT_NUMBER=your-project-number

# --- LLM Model & Regional Settings ---
# Gemini foundational model to use for the agent (e.g. gemini-2.5-flash, gemini-2.5-pro)
LLM_MODEL=gemini-2.5-flash

# Primary Google Cloud Region for Vertex AI Reasoning Engines & Gemini LLM
LLM_LOCATION=us-central1
GOOGLE_CLOUD_LOCATION=us-central1

# Enable Vertex AI backend (Application Default Credentials, no API keys needed)
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Microsoft Entra ID (Azure AD) SSO Configuration ---
# Application (client) ID registered in Microsoft Entra Admin Center
ENTRA_CLIENT_ID=your-entra-client-id
# Directory (tenant) ID or primary domain
ENTRA_TENANT_ID=your-tenant-id.onmicrosoft.com
# Redirect URI configured in Entra App Registration
ENTRA_REDIRECT_URI=http://localhost:8000

# --- Google Cloud Workload Identity Federation (WIF) Configuration ---
# Workload Identity Pool ID (e.g. my-wif-pool)
GCP_WIF_POOL_ID=your-pool-id
# Workload Identity Provider ID (e.g. entra-provider)
GCP_WIF_PROVIDER_ID=your-oidc-provider-id

# --- Application Server & Agent Engine Configuration ---
PORT=8000
REASONING_ENGINE_ID=123456789012345678

